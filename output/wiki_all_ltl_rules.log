[00] ALWAYS (conversation_started IMPLIES EVENTUALLY locate_user_id_email)
[01] ALWAYS (conversation_started IMPLIES EVENTUALLY locate_user_id_name_zip)
[02] ALWAYS ((provide_order_info OR provide_product_info OR provide_profile_info) IMPLIES authenticated)
[03] ALWAYS (authenticated IMPLIES EVENTUALLY (provide_order_info OR provide_product_info OR provide_profile_info))
[04] ALWAYS (multi_user_request_detected IMPLIES deny_other_user_requests)
[05] ALWAYS ((cancel_request OR modify_request OR return_request OR exchange_request) IMPLIES EVENTUALLY (action_details_listed AND user_confirmed_yes))
[06] ALWAYS ((action_details_listed AND user_confirmed_yes) IMPLIES NEXT db_action_executed)
[07] ALWAYS time_in_est
[08] ALWAYS (tool_call_active IMPLIES NEXT NOT tool_call_active) AND ALWAYS (tool_call_active IMPLIES NOT user_response_sent) AND ALWAYS (user_response_sent IMPLIES NOT tool_call_active)
[09] ALWAYS (unhandled_request IMPLIES EVENTUALLY transfer_to_human)
[10] ALWAYS (user_profile_created IMPLIES (profile_email_present AND profile_default_address_present AND profile_user_id_present AND profile_payment_methods_present))
[11] ALWAYS (action_on_order IMPLIES (order_status_pending OR order_status_delivered))
[12] ALWAYS (cancel_order_requested -> order_status_pending)
[13] ALWAYS ((order_id_confirmed AND cancel_reason_valid) -> EVENTUALLY order_status_cancelled)
[14] ALWAYS (order_status_cancelled -> (refund_to_original_payment_method OR refund_to_gift_card))
[15] ALWAYS (modify_order_requested -> order_status_pending)
[16] ALWAYS (modify_pending_order -> (modify_shipping_address OR modify_payment_method OR modify_item_options))
[17] ALWAYS (pending_order_payment_modification_requested -> single_new_payment_method)
[18] ALWAYS (modify_payment_to_gift_card -> gift_card_balance_sufficient)
[19] ALWAYS (return_order_requested -> order_status_delivered)
[20] ALWAYS ((order_id_confirmed AND items_to_return_confirmed) -> EVENTUALLY email_sent)
[21] ALWAYS (order_status_return_requested -> (refund_to_original_payment_method OR refund_to_gift_card))
[22] ALWAYS (exchange_order_requested -> order_status_delivered)
[23] ALWAYS (items_for_exchange_confirmed -> EVENTUALLY exchange_completed)
[24] ALWAYS (exchange_payment_to_gift_card -> gift_card_balance_sufficient)
